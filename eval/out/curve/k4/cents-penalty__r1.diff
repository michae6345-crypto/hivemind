### ADDED src/payouts/penalty.ts
+ import type { Payout } from "./types";
+ const LATE_PENALTY_CENTS_PER_DAY = 250;
+ 
+ export function applyLatePenalty(payout: Payout, daysLate: number): Payout {
+   const days = Math.max(0, Math.floor(daysLate));
+   const amount = Math.max(0, payout.amount - days * LATE_PENALTY_CENTS_PER_DAY);
+   const memo = days > 0 ? `${payout.memo} (late penalty: ${days}d)` : payout.memo;
+   return { ...payout, amount, memo };
+ }
