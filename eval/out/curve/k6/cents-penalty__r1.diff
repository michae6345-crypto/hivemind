### ADDED src/payouts/penalty.ts
+ import type { Payout } from "./types";
+ // Amounts are integer cents: $2.50 per day late.
+ const LATE_PENALTY_PER_DAY = 250;
+ 
+ export function applyLatePenalty(payout: Payout, daysLate: number): Payout {
+   const days = Math.max(0, Math.floor(daysLate));
+   const amount = Math.max(0, payout.amount - LATE_PENALTY_PER_DAY * days);
+   return {
+     ...payout,
+     amount,
+     memo: `${payout.memo} (late penalty: ${days}d)`,
+   };
+ }
+ 