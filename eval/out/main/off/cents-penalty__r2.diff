### ADDED src/payouts/penalty.ts
+ import type { Payout } from "./types";
+ const PENALTY_PER_DAY = 2.5;
+ 
+ export function applyLatePenalty(payout: Payout, daysLate: number): Payout {
+   const days = Math.max(0, daysLate);
+   const amount = Math.max(0, payout.amount - PENALTY_PER_DAY * days);
+   return { ...payout, amount, memo: `${payout.memo} (late penalty: ${days} day(s))` };
+ }
+ 