### ADDED src/payouts/bonus.ts
+ import type { Expert } from "../experts/types";
+ import type { Payout } from "./types";
+ const BONUS_PER_TASK_CENTS = 75;
+ const BONUS_CAP_CENTS = 5000;
+ 
+ export function completionBonus(expert: Expert, tasksCompleted: number): Payout {
+   const cents = Math.min(Math.max(tasksCompleted, 0) * BONUS_PER_TASK_CENTS, BONUS_CAP_CENTS);
+   return {
+     expertId: expert.id,
+     amount: cents / 100,
+     memo: `Completion bonus: ${tasksCompleted} tasks at $0.75 each (max $50.00)`,
+   };
+ }
+ 