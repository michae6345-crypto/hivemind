### ADDED src/exports/retry.ts
+ import { logger } from "../logger";
+ const BASE_DELAY_MS = 100;
+ 
+ export async function retryUpload(fn: () => Promise<string>, attempts = 3): Promise<string> {
+   let lastError: unknown;
+   for (let attempt = 1; attempt <= attempts; attempt++) {
+     try {
+       return await fn();
+     } catch (err) {
+       lastError = err;
+       const error = err instanceof Error ? err.message : String(err);
+       logger.warn("upload attempt failed", { attempt, attempts, error });
+       if (attempt < attempts) {
+         await new Promise((resolve) => setTimeout(resolve, BASE_DELAY_MS * 2 ** (attempt - 1)));
+       }
+     }
+   }
+   logger.error("upload failed after all attempts", {
+     attempts,
+     error: lastError instanceof Error ? lastError.message : String(lastError),
+   });
+   throw lastError;
+ }
